# @param {Integer[]} nums1
# @param {Integer[]} nums2
# @return {Integer[]}
def next_greater_element(nums1, nums2)
    st = []
    map = {}
    nums2.each do |i|
     while !st.empty? && i > st[-1]
      ind = st.pop
      map[ind] = i
     end
     st.push(i)
    end

    ans = []
    nums1.each_with_index do |num,i|
     ans[i] = map.key?(num) ? map[num] : -1
    end
    ans
end
