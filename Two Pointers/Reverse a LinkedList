# Definition for singly-linked list.
# class ListNode
#     attr_accessor :val, :next
#     def initialize(val = 0, _next = nil)
#         @val = val
#         @next = _next
#     end
# end
# @param {ListNode} head
# @return {ListNode}
def reverse_list(head)
    return head if head.nil? || head.next.nil?

    prev = nil
    curr = head
    while curr
     nextptr = curr.next
     curr.next = prev
     prev = curr
     curr = nextptr
    end
    prev
end
